# Copy to .env and fill in. Key from https://opencode.ai/console (personal API key).
OPENCODE_API_KEY=

# Optional overrides: remove the leading "# " to turn a line on. No comments after a value.
# Endpoint: OpenCode Go (default). For pay-as-you-go Zen credits use https://opencode.ai/inference/openai/v1
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Model: glm-5.3-flash (default, fast) or deepseek-v4.1-flash or hy3
# OPENCODE_MODEL=deepseek-v4.1-flash
# Reasoning: low (default) | high | default (let the model decide; slower)
# OPENCODE_REASONING_EFFORT=low
# READER_PORT=8787
